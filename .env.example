# =============================================================
#  Environment Variables — JavaMail Project
#  Copy file này thành .env và điền giá trị thật vào.
#  File .env KHÔNG được commit lên Git (đã có trong .gitignore).
# =============================================================

# --- Gmail SMTP ---
# Địa chỉ Gmail dùng để gửi mail
GMAIL_USERNAME=your_email@gmail.com

# App Password 16 ký tự (KHÔNG phải mật khẩu Gmail thường)
# Tạo tại: Google Account → Security → 2-Step Verification → App passwords
GMAIL_APP_PASSWORD=xxxx xxxx xxxx xxxx

# --- Database (Aiven MySQL / Cloud MySQL) ---
# JDBC URL đầy đủ của cloud database
DB_URL=jdbc:mysql://your-host:port/your-db?useSSL=true&serverTimezone=UTC&allowPublicKeyRetrieval=true

# Tên user database
DB_USER=your_db_user

# Mật khẩu database
DB_PASS=your_db_password
